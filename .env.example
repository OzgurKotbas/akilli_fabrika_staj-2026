# Endüstriyel dağıtım için ortam değişkenleri
# Kopyasını oluşturup adını .env yapın

# Kurulum / Lokasyon ID'si (MQTT ID ve çıktı klasörleri için kullanılır)
DEPLOYMENT_ID=fabrika_a_hat_1

# MQTT Broker Ayarları
MQTT_BROKER=192.168.10.100
MQTT_PORT=1883
MQTT_TOPIC_BASE=patrol/alert

# Varsayılan Kamera Kaynağı
# Desteklenenler: video dosyası (.mp4), RTSP, HTTP stream, veya webcam index (0, 1)
CAMERA_SOURCE=rtsp://admin:pass@192.168.1.10:554/stream1

# Referans karelerin dizini
REF_DIR=data/waypoints/referans_kareler/
